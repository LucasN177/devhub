@inject IProjectService ProjectService

<div class="pa-4 pb-2">
    <MudText Typo="Typo.overline" Class="mud-text-secondary">Übersicht</MudText>
</div>
<MudNavMenu Class="px-2">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.SpaceDashboard">Dashboard</MudNavLink>
</MudNavMenu>

<div class="pa-4 pb-2 d-flex align-center">
    <MudText Typo="Typo.overline" Class="mud-text-secondary flex-grow-1">Projekte</MudText>
    @if (_projects is not null)
    {
        <span class="tech-tag">@_projects.Count</span>
    }
</div>
<MudNavMenu Class="px-2 pb-4">
    @if (_projects is null)
    {
        @for (var i = 0; i < 4; i++)
        {
            <MudSkeleton Height="40px" Class="mx-2 my-1" />
        }
    }
    else
    {
        @foreach (var project in _projects)
        {
            <MudNavLink Href="@($"projects/{project.Slug}")" Match="NavLinkMatch.All">
                <div class="d-flex align-center gap-3">
                    <span class="status-dot" style="background: @project.AccentColor"></span>
                    <span class="text-truncate">@project.Name</span>
                </div>
            </MudNavLink>
        }
    }
</MudNavMenu>

<div class="nav-footer">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">by Lucas Nagelsmann</MudText>
</div>

@code {
    private IReadOnlyList<Project>? _projects;

    protected override async Task OnInitializedAsync()
    {
        var result = await ProjectService.GetProjects();
        _projects = result.Data ?? [];
    }
}
